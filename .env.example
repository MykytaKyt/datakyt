# Copy to .env and adjust. Every setting is optional for local use; empty
# values fall back to the defaults documented in README.md.

# development | production | test. Production requires DATAKYT_JWT_SECRET.
DATAKYT_ENV=development
DATAKYT_LOG_LEVEL=INFO

# Database connection (used by the app, the CLI and docker compose).
DATAKYT_DB_HOST=localhost
DATAKYT_DB_PORT=5432
DATAKYT_DB_NAME=datakyt
DATAKYT_DB_USER=datakyt
DATAKYT_DB_PASSWORD=change-me
# A full SQLAlchemy URL overrides the DB_* values above.
# DATAKYT_DATABASE_URL=postgresql+psycopg://datakyt:change-me@localhost:5432/datakyt

# At least 32 characters. Generate one with: python -c "import secrets; print(secrets.token_urlsafe(48))"
# Without it a random key is generated per process and tokens expire on restart.
DATAKYT_JWT_SECRET=
DATAKYT_JWT_TTL_MINUTES=480

# First admin user created by `datakyt bootstrap` when no users exist.
# Without a password one is generated and printed once in the logs.
DATAKYT_ADMIN_EMAIL=admin@example.com
DATAKYT_ADMIN_PASSWORD=

# Load demo data on bootstrap when the database is empty.
DATAKYT_SEED_DEMO=false

# `datakyt backup` target directory and how many dumps to keep.
DATAKYT_BACKUP_DIR=backups
DATAKYT_BACKUP_KEEP=7

# Tests: a PostgreSQL database the test suite may wipe. Unset to use testcontainers.
# DATAKYT_TEST_DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/datakyt_test
